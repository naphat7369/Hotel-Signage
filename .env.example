# Shotel Hotel Digital Signage Configuration

# Network Port & Host
PORT=8787
HOST=0.0.0.0

# Predefined Admin Credentials (Auto-created on first run if database is empty)
ADMIN_EMAIL=admin@shotel.com
ADMIN_PASSWORD=admin12345678
ADMIN_NAME=Shotel Administrator
ORG_NAME=Shotel Grand
BRANCH_NAME=Main Branch

# Allow setup from remote IP (useful when first configuring on Proxmox / LAN)
ALLOW_REMOTE_SETUP=true

# Storage directory (defaults to ./data)
# DATA_DIR=/var/lib/shotel/data

# Optional TLS / HTTPS Certificate
# TLS_PFX=/path/to/certificate.pfx
# TLS_PASSWORD=cert_password
